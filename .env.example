# Copy to .env and fill in the values. Never commit .env.

# --- Gemini (Google AI Studio) ---
GOOGLE_API_KEY=

# --- Models (see https://ai.google.dev/gemini-api/docs/models) ---
AURORA_MODEL_ROOT=
AURORA_MODEL_SPECIALIST=
# Optional per-specialist overrides (default: AURORA_MODEL_SPECIALIST)
AURORA_MODEL_RESERVAS=
AURORA_MODEL_VISITANTES=
AURORA_MODEL_REGULAMENTO=

# --- Storage (defaults: ./var/aurora.db and ./var/sessions.db) ---
AURORA_DB_PATH=
AURORA_SESSIONS_DB_URL=
AURORA_DADOS_DIR=

# --- API ---
AURORA_ENABLE_DOCS=
LOG_LEVEL=

# --- Host ports (change them if they are already in use) ---
API_PORT=
PROMETHEUS_PORT=
GRAFANA_PORT=

# --- Grafana ---
GRAFANA_ADMIN_USER=
GRAFANA_ADMIN_PASSWORD=

# --- Container user (match your host user so ./var stays writable) ---
UID=
GID=
